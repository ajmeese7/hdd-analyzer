# Copy to .env and fill in. .env is gitignored.
# Either a native TypeSafe key or an OpenRouter key (prefix sk-or-) works.
# OpenRouter keys route through OpenRouter's Decisions API automatically.
TYPESAFE_API_KEY=your-key-here

# Optional override: openrouter or typesafe. Takes precedence over the
# key-prefix detection above. Leave unset to auto-detect from the key.
# JEV_PROVIDER=

# Optional: path to tesseract.exe if it is not on PATH (needed for OCR).
# Do not double-quote this value: python-dotenv treats double-quoted values
# as escaped strings, so \t in \tesseract.exe becomes a literal tab. Leave
# it unquoted or single-quoted.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
